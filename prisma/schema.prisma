// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "client"
}

datasource db {
  provider = "postgresql"
}

/// A Tenant is an isolated workspace. Every row of business data belongs to
/// exactly one tenant, and every user is a member of exactly one tenant.
/// Plan, quota and billing live here, not on the user.
model Tenant {
  id       String  @id @default(uuid()) @db.Uuid
  slug     String  @unique
  name     String
  /// Marks the shared, self-resetting demo workspace.
  isDemo   Boolean @default(false) @map("is_demo")
  isActive Boolean @default(true) @map("is_active")

  plan                String    @default("free")
  membershipExpiresAt DateTime? @map("membership_expires_at")
  stripeCustomerId    String?   @map("stripe_customer_id")

  /// Remaining AI analyses. Every new tenant starts with `aiCreditsLimit`.
  aiBalance      Int @default(5) @map("ai_balance")
  /// How many credits a refill grants, and the size of the quota bar in the UI.
  aiCreditsLimit Int @default(5) @map("ai_credits_limit")
  /// When set, the balance is topped back up to `aiCreditsLimit` after this
  /// many minutes. Used by the demo workspace (60 minutes); null = no refill.
  aiRefillMinutes Int?      @map("ai_refill_minutes")
  aiRefilledAt    DateTime? @map("ai_refilled_at")

  storageUsed  Int @default(0) @map("storage_used")
  storageLimit Int @default(-1) @map("storage_limit")
  /// Directory name this workspace's uploads live under. Kept separate from
  /// `slug` so existing installations keep their on-disk layout after the
  /// migration to multi-tenancy.
  storagePrefix String @unique @map("storage_prefix")

  businessName        String? @map("business_name")
  businessAddress     String? @map("business_address")
  businessBankDetails String? @map("business_bank_details")
  businessLogo        String? @map("business_logo")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users        User[]
  settings     Setting[]
  categories   Category[]
  projects     Project[]
  fields       Field[]
  files        File[]
  currencies   Currency[]
  transactions Transaction[]
  appData      AppData[]
  progress     Progress[]

  @@index([isDemo])
  @@map("tenants")
}

model User {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// owner | admin | member
  role          String        @default("owner")
  email         String        @unique
  name          String
  avatar        String?
  emailVerified Boolean       @default(false) @map("is_email_verified")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  settings      Setting[]
  categories    Category[]
  projects      Project[]
  fields        Field[]
  files         File[]
  currencies    Currency[]
  transactions  Transaction[]
  accounts      Account[]
  sessions      Session[]
  appData       AppData[]
  progress      Progress[]

  @@index([tenantId])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  token     String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("account")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verification")
}

model Setting {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String  @map("user_id") @db.Uuid
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  code        String
  name        String
  description String?
  value       String?

  @@unique([tenantId, code])
  @@index([userId])
  @@map("settings")
}

model Category {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String        @map("user_id") @db.Uuid
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  code         String
  name         String
  color        String        @default("#000000")
  llm_prompt   String?
  transactions Transaction[]
  createdAt    DateTime      @default(now()) @map("created_at")

  @@unique([tenantId, code])
  @@index([userId])
  @@map("categories")
}

model Project {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String        @map("user_id") @db.Uuid
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  code         String
  name         String
  color        String        @default("#000000")
  llm_prompt   String?
  transactions Transaction[]
  createdAt    DateTime      @default(now()) @map("created_at")

  @@unique([tenantId, code])
  @@index([userId])
  @@map("projects")
}

model Field {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId              String   @map("user_id") @db.Uuid
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code                String
  name                String
  type                String   @default("string")
  llm_prompt          String?
  options             Json?
  createdAt           DateTime @default(now()) @map("created_at")
  isVisibleInList     Boolean  @default(false) @map("is_visible_in_list")
  isVisibleInAnalysis Boolean  @default(false) @map("is_visible_in_analysis")
  isRequired          Boolean  @default(false) @map("is_required")
  isExtra             Boolean  @default(true) @map("is_extra")

  @@unique([tenantId, code])
  @@index([userId])
  @@map("fields")
}

model File {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId            String   @map("user_id") @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename          String
  path              String
  mimetype          String
  metadata          Json?
  isReviewed        Boolean  @default(false) @map("is_reviewed")
  isSplitted        Boolean  @default(false) @map("is_splitted")
  cachedParseResult Json?    @map("cached_parse_result")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("files")
}

model Transaction {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String?
  description           String?
  merchant              String?
  total                 Int?
  currencyCode          String?   @map("currency_code")
  convertedTotal        Int?      @map("converted_total")
  convertedCurrencyCode String?   @map("converted_currency_code")
  type                  String?   @default("expense")
  items                 Json      @default("[]")
  note                  String?
  files                 Json      @default("[]")
  extra                 Json?
  category              Category? @relation(fields: [categoryCode, tenantId], references: [code, tenantId])
  categoryCode          String?   @map("category_code")
  project               Project?  @relation(fields: [projectCode, tenantId], references: [code, tenantId])
  projectCode           String?   @map("project_code")
  issuedAt              DateTime? @map("issued_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  text                  String?

  @@index([tenantId])
  @@index([userId])
  @@index([projectCode])
  @@index([categoryCode])
  @@index([issuedAt])
  @@index([name])
  @@index([merchant])
  @@index([total])
  @@map("transactions")
}

model Currency {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String? @map("user_id") @db.Uuid
  user     User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  code     String
  name     String

  @@unique([tenantId, code])
  @@index([userId])
  @@map("currencies")
}

model AppData {
  id       String @id @default(uuid()) @db.Uuid
  app      String
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String @map("user_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  data     Json

  @@unique([tenantId, app])
  @@index([userId])
  @@map("app_data")
}

model Progress {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  data      Json?
  current   Int      @default(0)
  total     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([userId])
  @@map("progress")
}
